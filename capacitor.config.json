{
  "appId": "com.iupflow.jellydrop",
  "appName": "Jelly Drop",
  "webDir": "dist",
  "backgroundColor": "#05030f",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#05030f"
  },
  "android": {
    "backgroundColor": "#05030f"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#05030f",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK"
    }
  }
}
